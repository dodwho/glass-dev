    "resolutions": {
        "**/@eyeseetea/d2-api/axios": "1.20.0",
        "**/@eyeseetea/d2-api/form-data": "4.0.6",
        "**/@eyeseetea/d2-api/qs": "6.16.0",
        "**/@eyeseetea/d2-logger/@eyeseetea/d2-api": "1.21.0",
        "**/react-router/path-to-regexp": "1.9.0",
        "follow-redirects": "1.16.1",
        "handlebars": "4.7.10",
        "lodash": "4.18.1",
        "ua-parser-js": "0.7.41"
    },
    "scripts": {
        "start": "vite",
        "postinstall": "patch-package && yarn localize",
        "prebuild": "yarn localize && yarn test",
        "build-folder": "rm -rf build/ && vite build && node config/check-build-secrets.js && yarn run manifest && cp -r i18n icon.png build",
        "build-app": "yarn build-folder && rm -f ${npm_package_name}-${npm_package_version}.zip && cd build && zip --quiet -r ../${npm_package_name}-${npm_package_version}.zip *",
        "build": "yarn build-app && yarn build-amc-recalculate && yarn build-async-deletions && yarn build-async-uploads",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint src e2e",
        "prettify": "prettier \"./**/*.{js,jsx,json,css,ts,tsx}\" --write",
        "extract-pot": "d2-i18n-extract -p src/ -o i18n/",
        "localize": "yarn update-po && d2-i18n-generate -n glass -p ./i18n/ -o ./src/locales/",
        "update-po": "yarn extract-pot",
        "manifest": "d2-manifest package.json build/manifest.webapp",
        "e2e": "playwright test",
        "e2e:dev": "cross-env E2E_ALLOW_WRITES=1 playwright test",
        "prepare": "husky install",
        "script-example": "npx ts-node src/scripts/index.ts example getExample",
        "start-amc-recalculate": "npx ts-node src/scripts/cliAMC.ts  --debug",
        "build-amc-recalculate": "ncc build src/scripts/cliAMC.ts -m -o $npm_package_name-amc-recalculate-server && zip -r $npm_package_name-amc-recalculate-server-$npm_package_version.zip $npm_package_name-amc-recalculate-server && shx rm -rf $npm_package_name-amc-recalculate-server",
        "start-async-deletions": "npx ts-node -r dotenv/config src/scripts/cliAsyncDeletions.ts",
        "build-async-deletions": "ncc build src/scripts/cliAsyncDeletions.ts -m -o $npm_package_name-async-deletions-server && zip -r $npm_package_name-async-deletions-server-$npm_package_version.zip $npm_package_name-async-deletions-server && shx rm -rf $npm_package_name-async-deletions-server",
        "start-async-uploads": "npx ts-node -r dotenv/config src/scripts/cliAsyncUploads.ts",
        "build-async-uploads": "ncc build src/scripts/cliAsyncUploads.ts -m -o $npm_package_name-async-uploads-server && zip -r $npm_package_name-async-uploads-server-$npm_package_version.zip $npm_package_name-async-uploads-server && shx rm -rf $npm_package_name-async-uploads-server",
        "amr-agg-data-validation-ris": "npx ts-node -r dotenv/config src/scripts/amr_agg_data_validation.ts",
        "amr-agg-data-reset-ris": "npx ts-node -r dotenv/config src/scripts/amr_agg_data_reset.ts",
        "amr-agg-data-validation-sample": "npx ts-node -r dotenv/config src/scripts/amr_agg_data_validation_sample.ts",
        "amr-agg-data-reset-sample": "npx ts-node -r dotenv/config src/scripts/amr_agg_data_reset_sample.ts",
        "get-max-min-amc-calculated-tons": "npx ts-node -r dotenv/config src/scripts/get_max_min_amc_calculated_tons.ts",
        "generate-secret-key-and-nonce": "npx ts-node src/scripts/generate_secret_key_and_nonce.ts",
        "migrate-uploads-from-datastore-to-program": "npx ts-node -r dotenv/config src/scripts/uploads_datastore_to_uploads_event_program_migration.ts",
        "add-upload-date-uploads-event-program": "npx ts-node -r dotenv/config src/scripts/add_upload_date_uploads_event_program.ts",
        "bulk-download-amc-files": "cross-env NODE_OPTIONS=--max-old-space-size=4096 npx ts-node -r ./src/scripts/registerD2UiComponentsCjsInterop.js -r dotenv/config src/scripts/bulkDownloadAMCFiles.ts",
        "bulk-download-amr-individual-files": "cross-env NODE_OPTIONS=--max-old-space-size=8192 npx ts-node -r ./src/scripts/registerD2UiComponentsCjsInterop.js -r dotenv/config src/scripts/bulkDownloadAMRIndividualFiles.ts",
        "bulk-download-amr-agg-files": "cross-env NODE_OPTIONS=--max-old-space-size=8192 npx ts-node -r ./src/scripts/registerD2UiComponentsCjsInterop.js src/scripts/bulkDownloadAMRAggFiles.ts",
        "amc-coverage-audit": "npx ts-node -r ./src/scripts/registerD2UiComponentsCjsInterop.js -r dotenv/config src/scripts/amc_coverage_audit.ts",
        "download-amc-empty-templates": "npx ts-node -r ./src/scripts/registerD2UiComponentsCjsInterop.js -r dotenv/config src/scripts/downloadAMCEmptyTemplates.ts",
        "update-tons-to-kilograms": "npx ts-node -r dotenv/config src/scripts/update_autocalculated_and_manual_tons_to_kilograms.ts",
        "migrate-async-deletions-datastore": "npx ts-node -r dotenv/config src/scripts/async_deletions_migrate_new_datastore.ts",
        "amc-recalculate-local": "npx ts-node -P src/scripts/tsconfig.json src/scripts/cliAMCEnv.ts",
        "amc-delete-data": "npx ts-node -r dotenv/config src/scripts/amc_delete_data_for_period_ou.ts",
        "enrol-countries": "npx ts-node -r dotenv/config src/scripts/enrol_countries_in_modules.ts",
        "release-preflight": "npx ts-node -r ./src/scripts/registerD2UiComponentsCjsInterop.js -r dotenv/config src/scripts/release_preflight.ts"
    },
    "manifest.webapp": {
        "name": "glass",
        "description": "DHIS2 Glass App",
        "icons": {
            "48": "icon.png"
        },
        "developer": {
            "url": "https://www.eyeseetea.com/",
            "name": "EyeSeeTea team"
        },
        "activities": {
            "dhis": {
                "href": "*"
            }
        }
    },
    "keywords": [],
    "bugs": {
        "url": "https://github.com/EyeSeeTea/glass-dev/issues"
    },
    "engines": {
        "node": ">=24"
    }
}
